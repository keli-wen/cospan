{
  "name": "cospan",
  "version": "0.1.1",
  "description": "Unified orchestration across coding agents — connect Antigravity, Codex, Claude Code, and DeepSeek Harness through one async delegation protocol.",
  "type": "module",
  "bin": {
    "cospan": "./bin/cospan.mjs"
  },
  "icon": "./assets/icon.svg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keli-wen/cospan.git"
  },
  "homepage": "https://github.com/keli-wen/cospan",
  "bugs": "https://github.com/keli-wen/cospan/issues",
  "keywords": [
    "cospan",
    "claude-code-plugin",
    "codex-plugin",
    "antigravity-plugin",
    "dsh-plugin",
    "agent-skills",
    "mcp",
    "mcp-server",
    "claude-code",
    "codex",
    "antigravity",
    "deepseek-harness",
    "multi-agent",
    "coding-agent",
    "orchestration",
    "subagents",
    "ai-agents",
    "code-review",
    "agentic-ai",
    "developer-tools"
  ],
  "files": [
    "assets/",
    "bin/",
    "src/",
    "skills/",
    "dsh/",
    ".antigravity-plugin/",
    ".claude-plugin/",
    ".codex-plugin/",
    ".agents/",
    ".mcp.json",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./dsh/cordis.patch.yml",
      "platforms": [
        "darwin",
        "linux",
        "win32"
      ],
      "listedByDefault": true
    }
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "sync:ui": "node src/ui/sync-dsh-client.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-n": "^18.5.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1"
  }
}
